    #!/bin/csh -
    # call this "run_stripper"
    # To use: run_stripper *.f
    #
trans_dir=/home/barad-dur/jwd/users/mercedes-tmp/xiaoye/Clapack/translate
    rm -f -r *.t
    for file do
      # make base name by removing the ".f"
      base=`echo $file | sed -e 's/\.f//g'`
      ${trans_dir}/f2c -A < ${base}.f | ${trans_dir}/lenscrub > ${base}.c
    done





