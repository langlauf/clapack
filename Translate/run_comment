    #!/bin/sh -
    # call this "run_comment"
    # delete unwanted lines, and combine consecutive lines of comments 
    #
trans_dir=/home/barad-dur/jwd/users/mercedes-tmp/xiaoye/Clapack/translate
    for file do
       # make base name by removing the ".c"
       base=`echo $file | sed -e 's/\.c//g'`
       sed -f ${trans_dir}/delete.sed ${base}.c > ${base}.t
       mv -f ${base}.t ${base}.c
       ${trans_dir}/comment < ${base}.c > ${base}.t
       mv -f ${base}.t ${base}.c
    done

