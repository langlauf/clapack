    #!/bin/sh -
    # call this "run_splitter"
    # split into several pieces, then cat appropriately.
trans_dir=/home/barad-dur/jwd/users/mercedes-tmp/xiaoye/Clapack/translate
    mkdir temp
    for file do
       # make base name by removing the ".c"
       base=`echo $file | sed -e 's/\.c//g'`
       sed -n -f ${trans_dir}/split.sed ${base}.c
       mv -f ${base}.c ${base}.t
       cat temp/header1 temp/header3 temp/comment temp/header2 temp/prologue \
       		temp/code > ${base}.c
       rm -f ${base}.t
    done
    rm -f -r temp

