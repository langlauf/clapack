    #!/bin/csh -
    # call this "run_macro"
    # To use: run_macro *.c
    # better vector and array indexing; from NAG
    #
trans_dir=/home/barad-dur/jwd/users/mercedes-tmp/xiaoye/Clapack/translate
    for file do
      # make base name by removing the ".c"
      base=`echo $file | sed -e 's/\.c//g'`
	${trans_dir}/substitute_locals.exe < ${base}.c > ${base}.u
	${trans_dir}/test_tool.exe ${base}.u > ${base}.t
	mv -f ${base}.t ${base}.c
	rm -f ${base}.u
    done





